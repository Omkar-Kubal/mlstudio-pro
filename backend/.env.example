# ─────────────────────────────────────────────────────────────
# MLStudio Pro — Backend Environment Variables
# Copy this file to backend/.env and fill in real values.
# NEVER commit backend/.env to source control.
# ─────────────────────────────────────────────────────────────

# Set to "true" only for local development without Firebase.
# In production this MUST be "false".
USE_MOCK_AUTH=false

# Firebase service account credentials.
# Option A (local dev): absolute path to the JSON key file.
#   FIREBASE_SERVICE_ACCOUNT_JSON=/path/to/serviceAccount.json
# Option B (production / CI): paste the full JSON as a single-line string.
#   FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
# Option C (Google Cloud / Cloud Run): leave unset to use Application Default Credentials.
FIREBASE_SERVICE_ACCOUNT_JSON=

# IMPORTANT: ADMIN_EMAIL is now for display/reference only.
# Admin authorization is determined exclusively by the Firebase custom claim {"admin": true}.
# Use the set_admin.py script or the /admin/users/{uid}/make-admin endpoint to grant admin.
ADMIN_EMAIL=

# Comma-separated list of allowed frontend origins.
# MUST be set in production. Cannot be "*" when credentials are used.
# Example: ALLOWED_ORIGINS=https://mlstudio.pro,https://www.mlstudio.pro
ALLOWED_ORIGINS=http://localhost:3000
